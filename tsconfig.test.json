{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",

		// Tests may exercise either side, so they get both environments. This
		// project exists purely to typecheck test files — it enforces no boundary,
		// which is exactly why the production projects must exclude tests.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"]
	},
	// raw.d.ts: tests reach the Phosphor `?raw` imports through the score
	// overlay (render/ui.ts), and an ambient declaration is never pulled in by
	// an import.
	"include": ["src/**/*.test.ts", "tests/**/*.ts", "src/host/raw.d.ts"]
}
