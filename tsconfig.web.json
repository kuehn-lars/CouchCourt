{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],

		// Empty on purpose. Without @types/node, any Node API that leaks into
		// src/shared fails here.
		"types": []
	},
	"include": [
		"src/shared/**/*.ts",
		"src/host/**/*.ts",
		"src/controller/**/*.ts"
	],
	"exclude": ["**/*.test.ts"]
}
